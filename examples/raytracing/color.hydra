include vec3::Vec3;
include interval::Interval;
include math::Math;

pub struct Color;

extension Color {

    pub fn new() -> Color {
        return Color {};
    }
    
    pub fn linear_to_gamma(component: f64) -> f64 {
        if component > 0 {
            return Math::sqrt(component);
        }

        return 0.0;
    }

    pub fn write_color(pixel: Vec3) -> void {
        let r = pixel::x();
        let g = pixel::y();
        let b = pixel::z();

        r = Color::linear_to_gamma(r);
        g = Color::linear_to_gamma(g);
        b = Color::linear_to_gamma(b);

        const intensity = Interval::new(0, 0.999);
        const rbyte: i32 = (256 * intensity::clamp(r)) as i32;
        const gbyte: i32 = (256 * intensity::clamp(g)) as i32;
        const bbyte: i32 = (256 * intensity::clamp(b)) as i32;

        println("{} {} {}\n", rbyte, gbyte, bbyte);
    }
}
