include math::Math;
include random::Random;

include core::marker::Copy;

pub struct Vec3 {
    x: f64;
    y: f64;
    z: f64;
}

extension Copy on Vec3;

extension Vec3 {
    
    pub fn new(x: f64, y: f64, z: f64) -> Vec3 {
        return Vec3 {
            .x = x,
            .y = y,
            .z = z,
        };
    }

    pub fn zero() -> Vec3 {
        return Vec3 {
            .x = 0,
            .y = 0,
            .z = 0,
        };
    }

    pub fn normalize(v: Vec3) -> Vec3 {
        const len: f64 = v::length();

        if len > 0.0 {
            return v::scale(1.0 / len);
        }

        return v;
    }

    pub fn random(rng: &mut Random) -> Vec3 {
        return Vec3::new(
            rng::random_number(),
            rng::random_number(),
            rng::random_number()
        );
    }

    pub fn random_within_range(rng: &mut Random, min: f64, max: f64) -> Vec3 {
        return Vec3::new(
            rng::random_range(min, max),
            rng::random_range(min, max),
            rng::random_range(min, max)
        );
    }

    pub fn random_normalize(rng: &mut Random) -> Vec3 {
        while true {
            const p = Vec3::random_within_range(rng, -1, 1);
            const lensq = p::length_squared();

            if 1e-160 < lensq && lensq <= 1 {
                return p::scale(1.0 / Math::sqrt(lensq));
            }
        }
    }

    pub fn random_on_hemisphere(rng: &mut Random, normal: Vec3) -> Vec3 {
        const on_unit_sphere = Vec3::random_normalize(rng);

        if on_unit_sphere::dot(normal) > 0.0 {
            return on_unit_sphere;
        } else {
            return on_unit_sphere::scale(-1.0);
        }
    }

    pub fn random_in_unit_disk(rng: &mut Random) -> Vec3 {
        while true {
            const p = Vec3::new(
                rng::random_range(-1, 1),
                rng::random_range(-1, 1),
                0
            );

            if p::length_squared() < 1 {
                return p;
            }
        }
    }

    pub fn reflect(v: Vec3, n: Vec3) -> Vec3 {
        return v::subtract(n::scale(2.0 * v::dot(n)));
    }

    pub fn refract(uv: Vec3, n: Vec3, eoe: f64) -> Vec3 {
        let uv_inv = uv::scale(-1.0);

        const cos_theta = Math::min(uv_inv::dot(n), 1.0);
        let r_out_perp: Vec3 = uv::add(n::scale(cos_theta))::scale(eoe);
        let r_out_para = n::scale(-Math::sqrt(Math::abs(1.0 - r_out_perp::dot(r_out_perp))));

        return r_out_perp::add(r_out_para);
    }


    pub fn add(&self, other: Vec3) -> Vec3 {
        return Vec3 {
            .x = self.x + other.x,
            .y = self.y + other.y,
            .z = self.z + other.z,
        };
    }

    pub fn subtract(&self, other: Vec3) -> Vec3 {
        return Vec3 {
            .x = self.x - other.x,
            .y = self.y - other.y,
            .z = self.z - other.z,
        };
    }

    pub fn multiply(&self, other: Vec3) -> Vec3 {
        return Vec3 {
            .x = self.x * other.x,
            .y = self.y * other.y,
            .z = self.z * other.z,
        };
    }

    pub fn cross(&self, other: Vec3) -> Vec3 {
        return Vec3::new(
            (self.y * other.z) - (self.z * other.y),
            (self.z * other.x) - (self.x * other.z),
            (self.x * other.y) - (self.y * other.x)
        );
    }

    pub fn scale(&self, factor: f64) -> Vec3 {
        return Vec3 {
            .x = self.x * factor,
            .y = self.y * factor,
            .z = self.z * factor,
        };
    }

    pub fn dot(&self, other: Vec3) -> f64 {
        return (self.x * other.x) + (self.y * other.y) + (self.z * other.z);
    }

    pub fn length_squared(&self) -> f64 {
        return self::dot(*self);
    }

    pub fn length(&self) -> f64 {
        return Math::sqrt(self::length_squared());
    }

    pub fn near_zero(&self) -> bool {
        const s = 1e-8;

        return Math::abs(self.x) < s && Math::abs(self.y) < s && Math::abs(self.z) < s;
    }

    pub fn x(&self) -> f64 {
        return self.x;
    }

    pub fn y(&self) -> f64 {
        return self.y;
    }

    pub fn z(&self) -> f64 {
        return self.z;
    }
}
