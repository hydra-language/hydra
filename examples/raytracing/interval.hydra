include math::Math;

include core::marker::Copy;

pub struct Interval {
    pub min: f64;
    pub max: f64;

    const EMPTY: Interval = Interval {
        .min = 1.0 / 0.0,
        .max = -(1.0 / 0.0)
    };

    const UNIVERSE: Interval = Interval {
        .min = -(1.0 / 0.0),
        .max = 1.0 / 0.0
    };
}

extension Copy on Interval;

extension Interval {
    
    pub fn new(min: f64, max: f64) -> Interval {
        return Interval {
            .min = min,
            .max = max
        };
    }

    pub fn initialize() -> Interval {
        return Interval::EMPTY;
    }
    
    pub fn size(&self) -> f64 {
        return self.max - self.min;
    }
    
    pub fn contains(&self, x: f64) -> bool {
        return self.min <= x && x <= self.max;
    }

    pub fn surrounds(&self, x: f64) -> bool {
        return self.min < x && x < self.max;
    }

    pub fn clamp(&self, x: f64) -> f64 {
        if x < self.min {
            return self.min;
        }

        if x > self.max {
            return self.max;
        }

        return x;
    }
}
