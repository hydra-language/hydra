include core::marker::Copy;

include vec3::Vec3;

pub struct Ray {
    origin: Vec3;
    direction: Vec3;
}

extension Copy on Ray;

extension Ray {
    
    pub fn new(origin: Vec3, direction: Vec3) -> Ray {
        return Ray {
            .origin = Vec3::zero(),
            .direction = Vec3::zero()
        };
    }

    fn initialize(origin: Vec3, direction: Vec3) -> Ray {
        return Ray {
            .origin = origin,
            .direction = direction
        };
    }

    fn at(&self, t: f64) -> Vec3 {
        let scaled: Vec3 = self.direction::scale(t);
        return self.origin::add(scaled);
    }

    fn origin(&self) -> Vec3 {
        return self.origin;
    }

    fn direction(&self) -> Vec3 {   
        return self.direction;
    }
}
