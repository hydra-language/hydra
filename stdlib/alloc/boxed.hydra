include core::alloc::Allocator;
include core::alloc::Layout;

include core::mem;

include core::ptr;
include core::ptr::NonNull;

include core::ops::Drop;

pub struct Box<T> {
    ptr: NonNull<T>;
}

extension<T> Drop on Box<T> {
    fn drop(&mut self) -> void {
        const layout = Layout::new::<T>();
        const pointer = self.ptr::as_const_ptr();
        const value = ptr::read::<T>(pointer);

        mem::drop(value);

        Allocator::dealloc(pointer as *mut u8, layout);
    }
}

extension<T> Box<T> {
    
    pub fn new(value: T) -> Box<T> {
        const layout = Layout::new::<T>();
        const memory = Allocator::alloc(layout);
        const pointer = memory as *mut T;

        ptr::write::<T>(pointer, value);

        return Box {
            .ptr = NonNull::<T>::new_unchecked(pointer)
        };
    }

    pub fn as_ptr(&self) -> *mut T {
        return self.ptr::as_ptr();
    }

    pub fn as_const_ptr(&self) -> *const T {
        return self.ptr::as_const_ptr();
    }

    pub fn into_inner(self) -> T {
        const p = self.ptr::as_const_ptr();
        const value = ptr::read::<T>(p);

        return value;
    }
}
