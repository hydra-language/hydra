include core::alloc::Allocator;
include core::alloc::Layout;

include core::ptr;
include core::ptr::NonNull;

include core::ops::Clone;
include core::ops::Drop;
include core::ops::Deref;
include core::ops::DerefMut;

include core::mem;

include core::fmt::Display;
include core::fmt::Formatter;

// growable, heap allocated, array type
pub struct Vec<T> {
    ptr: NonNull<T>;
    len: usize;
    cap: usize;

    // there might be some UB going on here
    // because it prints out some random number every
    // time if the drop destructor is ran with a print 
    // statement that prints it out
    const MINIMUM_CAP: usize = if mem::size_of::<T>() == 1 {
        8;
    } else if mem::size_of::<T>() <= 1024 {
        4;
    } else {
        1;
    };
}

extension<T> Clone on Vec<T> where T : Clone {
    fn clone(&self) -> Vec<T> {
        let clone = Vec::with_capacity(self.len);

        let i: usize = 0;
        while i < self.len {
            const element_ptr = ptr::offset::<T>(
                self.ptr::as_ptr(),
                i as isize
            );

            const value = &*element_ptr;

            clone::push(value::clone());

            i += 1;
        }

        return clone;
    }
}

extension<T> Drop on Vec<T> {
    fn drop(&mut self) -> void {
        let i: usize = 0;

        // drop every initialized element
        //
        // ptr::read() moves the element out of the allocation
        // and mem::drop<T>() then runs whatever drop glue T
        // requires
        while i < self.len {
            const element_ptr = ptr::offset::<T>(
                self.ptr::as_ptr(), 
                i as isize
            );

            const value = ptr::read::<T>(element_ptr as *const T);

            mem::drop::<T>(value);

            i += 1;
        }

        // ZST Vecs never allocated backing storage
        if mem::size_of::<T>() == 0 {
            return;
        }

        // cap == 0 means this is still using NonNull::dangling()
        if self.cap == 0 {
            return;
        }

        const layout = Layout::from_size_align(
            mem::size_of::<T>() * self.cap,
            mem::align_of::<T>()
        );

        Allocator::dealloc(self.ptr::as_ptr() as *mut u8, layout);
    }
}

extension<T> Display on Vec<T> where T : Display {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        formatter::write("[");

        for i in 0..self.len {
            if i > 0 {
                formatter::write(", ");
            }

            const element_ptr = ptr::offset::<T>(
                self.ptr::as_ptr(),
                i as isize
            );

            const value = &*element_ptr;
            value::fmt(formatter);
        }

        formatter::write("]");
    }
}

extension<T> Deref<[T]> on Vec<T> {
    #[inline]
    fn deref(&self) -> &[T] {
        return Vec::slice_from_raw_parts(self.ptr::as_ptr(), self.len);
    }
}

extension<T> DerefMut<[T]> on Vec<T> {
    #[inline]
    fn deref_mut(&mut self) -> &mut [T] {
        return Vec::slice_from_raw_parts_mut(self.ptr::as_ptr(), self.len);
    }
}

extension<T> Vec<T> {

    // FIXME: this shouldnt really work and results in LLVM
    // saying that i cant assign to it. small fix but i didnt
    // know i supported if statements as expressions lol
    /* const MINIMUM_CAP: usize = if mem::size_of::<T>() == 1 {
        8;
    } else if mem::size_of::<T>() <= 1024 {
        4;
    } else {
        1;
    }; */
    
    // Constructs a new and empty Vec<T>
    //
    // NOTE: no allocations happen until an element is pushed
    pub fn new() -> Vec<T> {
        return Vec {
            .ptr = NonNull::dangling(),
            .len = 0,
            .cap = 0,
        };
    }

    // Constructs a new and empty Vec<T> with AT LEAST the specified capacity
    // 
    // NOTE: ZSTs do NOT allocate
    //  - A ZST (Zero Sized Type) is a T whos size_of == 0
    pub fn with_capacity(cap: usize) -> Vec<T> {

        // ZSTs never allocate
        if mem::size_of::<T>() == 0 {
            return Vec {
                .ptr = NonNull::dangling(),
                .len = 0,
                .cap = cap,
            };
        }

        if cap == 0 { return Vec::new(); }

        const layout = Layout::from_size_align(
            mem::size_of::<T>() * cap,
            mem::align_of::<T>()
        );

        const memory = Allocator::alloc(layout);
        const p = memory as *mut T;

        return Vec {
            .ptr = NonNull::new_unchecked(p),
            .len = 0,
            .cap = cap
        };
    }

    // Appends an element to the back of the Vec<T>
    //
    // NOTE: if the new capacity exceedes isize::MAX bytes
    // a panic will occur
    //
    // IMPLEMENTATION: use the push_mut() documentation
    // to write the push() method because deferring to
    // a push_mut function is stupid if you cant do a push_const
    pub fn push(&mut self, value: T) -> void {
        //
        // A ZST consumes no storage.
        //
        // There is deliberately no ptr::write here because
        // NonNull::dangling() is not dereferenceable.
        // 
        if mem::size_of::<T>() == 0 {
            self.len += 1;
            return;
        }

        if self.len == self.cap {
            self::grow();
        }

        const dst = ptr::offset::<T>(self.ptr::as_ptr_mut(), self.len as isize);
        ptr::write::<T>(dst, value);

        self.len += 1;
    }

    pub fn pop(&mut self) -> T? {
        if self.len == 0 {
            return None;
        }

        self.len -= 1;

        if mem::size_of::<T>() == 0 {
            const value = ptr::read::<T>(
                self.ptr::as_ptr_mut() as *const T
            );

            return value;
        }

        const element_ptr = ptr::offset::<T>(
            self.ptr::as_ptr_mut(),
            self.len as isize
        );

        const value = ptr::read::<T>(element_ptr as *const T);

        return value;
    }

    pub fn grow(&mut self) -> void {
        // ZSTs have no backing allocation to grow
        if mem::size_of::<T>() == 0 {
            return;
        }

        const MINIMUM_CAP: usize = if mem::size_of::<T>() == 1 {
            8;
        } else if mem::size_of::<T>() <= 1024 {
            4;
        } else {
            1;
        };

        const new_cap: usize = if self.cap == 0 { 
            MINIMUM_CAP;
        } else { 
             self.cap * 2; 
        };

        const new_layout = Layout::from_size_align(
            mem::size_of::<T>() * new_cap,
            mem::align_of::<T>()
        );

        const new_memory = Allocator::alloc(new_layout);
        const new_ptr = new_memory as *mut T;

        let i = 0;
        while i < self.len {
            const src = ptr::offset::<T>(
                self.ptr::as_ptr_mut(), 
                i as isize
            );

            const value = ptr::read::<T>(src);

            const dst = ptr::offset::<T>(
                new_ptr,
                i as isize
            );

            ptr::write::<T>(dst, value);

            i += 1;
        }

        if self.cap != 0 {
            const old_layout = Layout::from_size_align(
                mem::size_of::<T>() * self.cap,
                mem::align_of::<T>()
            );

            Allocator::dealloc(self.ptr::as_ptr_mut() as *mut u8, old_layout);
        }

        self.ptr = NonNull::new_unchecked(new_ptr);
        self.cap = new_cap;
    }

    #[inline]
    pub fn get(&self, index: usize) -> (&T)? {
        if index >= self.len {
            return None;
        }

        return self::get_unchecked(index);
    }

    #[inline]
    pub fn get_mut(&mut self, index: usize) -> (&mut T)? {
        if index >= self.len {
            return None;
        }

        return self::get_unchecked_mut(index);
    }

    #[inline]
    pub fn get_unchecked(&self, index: usize) -> &T {
        const element_ptr = ptr::offset::<T>(
            self.ptr::as_ptr(),
            index as isize
        );

        return &*element_ptr;
    }

    #[inline]
    pub fn get_unchecked_mut(&mut self, index: usize) -> &mut T {
        const element_ptr = ptr::offset::<T>(
            self.ptr::as_ptr_mut(),
            index as isize
        );

        return &mut *element_ptr;
    }

    #[inline]
    pub fn slice_from_raw_parts(p: *const T, len: usize) -> &[T] {
        return ptr::slice_from_raw_parts::<T>(p, len);
    }

    #[inline]
    pub fn slice_from_raw_parts_mut(p: *mut T, len: usize) -> &mut [T] {
        return ptr::slice_from_raw_parts_mut::<T>(p, len);
    }

    #[inline]
    pub fn capacity(&self) -> usize {
        return self.cap;
    }

    #[inline]
    pub fn len(&self) -> usize {
        return self.len;
    }

    #[inline]
    pub fn first(&self) -> &T {
        return &*self::get_unchecked(0);
    }

    #[inline]
    pub fn last(&self) -> &T {
        return &*self::get_unchecked(self::len() - 1);
    }

    #[inline]
    pub fn is_empty(&self) -> bool {
        return self.len == 0;
    }

    #[inline]
    pub fn ptr(&self) -> *const T {
        return self.ptr::as_ptr();
    }

    #[inline]
    pub fn ptr_mut(&mut self) -> *mut T {
        return self.ptr::as_ptr_mut();
    }
}
