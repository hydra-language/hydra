include core::fmt::Formatter;
include core::fmt::Display;

include core::fmt::number;

extension<T> Display on *mut T {
    #[inline]
    fn fmt(&self, formatter: &mut Formatter) -> void {
        number::write_pointer(
            formatter,
            *self as usize
        );
    }
}

extension<T> *mut T {

    #[inline]
    pub fn is_null(self) -> bool {
        return self as usize == 0;
    }
}


extension<T> Display on *const T {
    #[inline]
    fn fmt(&self, formatter: &mut Formatter) -> void {
        number::write_pointer(
            formatter,
            *self as usize
        );
    }
}

extension<T> *const T {

    #[inline]
    pub fn is_null(self) -> bool {
        return self as usize == 0;
    }
}
