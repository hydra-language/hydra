include core::intrinsics;

include core::fmt::Display;
include core::fmt::Formatter;

extension<T> Display on [T] where T : Display {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        formatter::write("[");

        for i in 0..self::len() {
            if i > 0 {
                formatter::write(", ");
            }

            const value = &self[i];
            value::fmt(formatter);
        }

        formatter::write("]");
    }
}

/* extension<T> Display on &[T] {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        formatter::write(*self);
    }
}

extension<T> Display on &mut [T] {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        formatter::write(*self);
    }
} */

// blanket extension on slice types
extension<T> [T] {
    
    #[inline]
    pub fn len(&self) -> usize {
        return intrinsics::__slice_len(self);
    }

    #[inline]
    pub fn first(&self) -> (&T)? {
        if self::is_empty() {
            return None;
        }

        return self::first_unchecked();
    }

    #[inline]
    pub fn first_unchecked(&self) -> &T {
        return &self[0];
    }

    #[inline]
    pub fn last(&self) -> (&T)? {
        if self::is_empty() {
            return None;
        }

        return self::last_unchecked();
    }

    #[inline]
    pub fn last_unchecked(&self) -> &T {
        return &self[self::len() - 1];
    }

    #[inline]
    pub fn is_empty(&self) -> bool {
        return self::len() == 0;
    }
}
