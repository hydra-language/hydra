include core::intrinsics;

include core::fmt::Display;
include core::fmt::Formatter;

// blanket extension on slice types
extension<T> [T] {
    
    #[inline]
    pub fn len(&self) -> usize {
        return intrinsics::__slice_len(self);
    }

    #[inline]
    pub fn first(&self) -> (&T)? {
        if self::is_empty() {
            return None;
        }

        return &self[0];
    }

    #[inline]
    pub fn last(&self) -> (&T)? {
        if self::is_empty() {
            return None;
        }

        return &self[self::len() - 1];
    }

    #[inline]
    pub fn is_empty(&self) -> bool {
        return self::len() == 0;
    }
}

extension Display on &[u8] {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        formatter::write(*self);
    }
}
