include core::fmt::Display;
include core::fmt::Formatter;

include core::intrinsics;
include core::mem::Uninit;

include core::ptr;

pub fn write_pointer(formatter: &mut Formatter, address: usize) -> void {
    formatter::write("0x");

    if address == 0 {
        formatter::write("0");
        return;
    }

    let buffer: Uninit<[u8, 16]> = Uninit::new();
    const buffer_ptr = buffer::as_mut_ptr() as *mut u8;

    let value = address;
    let len: usize = 0;

    while value != 0 {
        const digit = value % 16;

        const byte: u8 = if digit < 10 {
            digit as u8 + 48;
        } else {
            digit as u8 - 10 + 97;
        };

        ptr::write::<u8>(
            ptr::offset::<u8>(buffer_ptr, len as isize),
            byte
        );

        value /= 16;
        len += 1;
    }

    let i: isize = 0;
    while i < len {
        const index = len - i - 1;
        const byte_ptr = ptr::offset::<u8>(
            buffer_ptr,
            index as isize
        );

        formatter::write_raw(
            byte_ptr as *const u8,
            1
        );

        i += 1;
    }
}

fn write_i64(formatter: &mut Formatter, value: i64) -> void {
    let buffer = Uninit::<[u8, 20]>::new();

    const ptr = buffer::as_mut_ptr() as *mut u8;
    const len = intrinsics::__format_i64(value, ptr);

    formatter::write_raw(
        ptr as *const u8,
        len
    );
}

fn write_u64(formatter: &mut Formatter, value: u64) -> void {
    let buffer = Uninit::<[u8, 20]>::new();

    const ptr = buffer::as_mut_ptr() as *mut u8;
    const len = intrinsics::__format_u64(value, ptr);

    formatter::write_raw(
        ptr as *const u8,
        len
    );
}

extension Display on i8 {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_i64(
            formatter,
            *self as i64
        );
    }
}

extension Display on i16 {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_i64(
            formatter,
            *self as i64
        );
    }
}

extension Display on i32 {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_i64(
            formatter,
            *self as i64
        );
    }
}

extension Display on i64 {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_i64(
            formatter,
            *self
        );
    }
}

extension Display on isize {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_i64(
            formatter,
            *self as i64
        );
    }
}

extension Display on u8 {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_u64(
            formatter,
            *self as u64
        );
    }
}

extension Display on u16 {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_u64(
            formatter,
            *self as u64
        );
    }
}

extension Display on u32 {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_u64(
            formatter,
            *self as u64
        );
    }
}

extension Display on u64 {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_u64(
            formatter,
            *self
        );
    }
}

extension Display on usize {
    fn fmt(&self, formatter: &mut Formatter) -> void {
        write_u64(
            formatter,
            *self as u64
        );
    }
}
