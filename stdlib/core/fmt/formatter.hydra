include core::io;

include core::intrinsics;

pub struct Formatter {
    stdout: io::Stdout;
    stderr: io::Stderr;
    write_stderr: bool;
}

extension Formatter {

    #[inline]
    pub fn new() -> Formatter {
        return Formatter::stdout();
    }

    #[inline]
    pub fn stdout() -> Formatter {
        return Formatter {
            .stdout = io::Stdout {},
            .stderr = io::Stderr {},
            .write_stderr = false,
        };
    }

    #[inline]
    pub fn stderr() -> Formatter {
        return Formatter {
            .stdout = io::Stdout {},
            .stderr = io::Stderr {},
            .write_stderr = true,
        };
    }

    #[inline]
    pub fn write(&mut self, text: &string) -> void {
        self::write_raw(
            intrinsics::__string_ptr(text),
            intrinsics::__string_len(text)
        );
    }

    #[inline]
    pub fn writeln(&mut self, text: &string) -> void {
        self::write(text);
        self::write("\n");
    }

    #[inline]
    pub fn write_raw(&mut self, ptr: *const u8, len: usize) -> void {
        if self.write_stderr {
            self.stderr::write(ptr, len);
            return;
        }

        self.stdout::write(ptr, len);
    }
}
