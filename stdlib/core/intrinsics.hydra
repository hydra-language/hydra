#[intrinsic]
pub fn __size_of<T>() -> usize;

#[intrinsic]
pub fn __align_of<T>() -> usize;

#[intrinsic]
pub fn __ptr_read<T>(src: *const T) -> T;

#[intrinsic]
pub fn __ptr_write<T>(dst: *mut T, value: T) -> void;

#[intrinsic]
pub fn __ptr_offset<T>(ptr: *mut T, count: isize) -> *mut T;

#[intrinsic]
pub fn __alloc(size: usize, align: usize) -> *mut u8;

#[intrinsic]
pub fn __dealloc(ptr: *mut u8, size: usize, align: usize) -> void;

#[intrinsic]
pub fn __slice_len<T>(slice: &[T]) -> usize;
