#[intrinsic]
pub fn __size_of<T>() -> usize;

#[intrinsic]
pub fn __align_of<T>() -> usize;

#[intrinsic]
pub fn __ptr_read<T>(src: *const T) -> T;

#[intrinsic]
pub fn __ptr_write<T>(dst: *mut T, value: T) -> void;

#[intrinsic]
pub fn __ptr_offset<T>(ptr: *mut T, count: isize) -> *mut T;

#[intrinsic]
pub fn __alloc(size: usize, align: usize) -> *mut u8;

#[intrinsic]
pub fn __dealloc(ptr: *mut u8, size: usize, align: usize) -> void;

#[intrinsic]
pub fn __ptr_null<T>() -> *const T;

#[intrinsic]
pub fn __ptr_null_mut<T>() -> *mut T;

#[intrinsic]
pub fn __ptr_is_null<T>(ptr: *const T) -> bool;

#[intrinsic]
pub fn __ptr_from_addr<T>(address: usize) -> *mut T;

#[intrinsic]
pub fn __slice_ptr<T>(slice: &[T]) -> *const T;

#[intrinsic]
pub fn __slice_len<T>(slice: &[T]) -> usize;

#[intrinsic]
pub fn __string_ptr(value: &string) -> *const u8;

#[intrinsic]
pub fn __string_len(value: &string) -> usize;

#[intrinsic]
pub fn __write_stdout(ptr: *const u8, len: usize) -> void;

#[intrinsic]
pub fn __write_stderr(ptr: *const u8, len: usize) -> void;

#[intrinsic]
pub fn __uninit<T>() -> T;

#[intrinsic]
pub fn __format_i64(value: i64, buffer: *mut u8) -> usize;

#[intrinsic]
pub fn __format_u64(value: u64, buffer: *mut u8) -> usize;

#[intrinsic]
pub fn __format_char(value: char, buffer: *mut u8) -> usize;
